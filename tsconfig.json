{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true,
    "skipLibCheck": true, "noEmit": true, "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "functions", "desktop/src/logic.ts", "desktop/src/logic.test.ts", "desktop/src/boot.ts", "scripts/*.d.ts", "scripts/monitor.ts", "scripts/monitor-lib.ts", "scripts/bilan.ts", "vite.config.ts"]
}
